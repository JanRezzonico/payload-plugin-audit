{
  "name": "payload-plugin-audit",
  "version": "0.3.0",
  "description": "Audit trail plugin for Payload CMS: records who created or updated documents, stores update deltas, and shows them in the admin panel.",
  "keywords": [
    "audit",
    "audit-log",
    "audit-trail",
    "payload-plugin",
    "payloadcms",
    "plugin"
  ],
  "packageManager": "pnpm@12.3.4",
  "homepage": "https://github.com/JanRezzonico/payload-plugin-audit",
  "bugs": {
    "url": "https://github.com/JanRezzonico/payload-plugin-audit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanRezzonico/payload-plugin-audit.git"
  },
  "funding": "https://rezzonico.dev/contact",
  "license": "MPL-2.0",
  "author": "Jan Rezzonico <jan@rezzonico.dev> (https://rezzonico.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/exports/client.ts",
      "types": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist && rm *.tsbuildinfo",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "docker:reload": "docker compose down -v && sleep 2 && docker compose up -d",
    "docker:backup": "docker compose exec -T postgres pg_dump -U postgres -d audit_plugin_payload  | gzip > pg-compose-backup.sql.gz",
    "docker:restore": "pnpm docker:reload && sleep 5 && gunzip -c pg-compose-backup.sql.gz | docker compose exec -T postgres psql -U postgres -d audit_plugin_payload 1>/dev/null && echo 'Database restored from backup.'",
    "generate": "pnpm generate:importmap && pnpm generate:types",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "test": "pnpm test:int",
    "test:e2e": "playwright test",
    "test:int": "vitest",
    "preversion": "pnpm lint && pnpm test --run && pnpm build && echo 'Preversion checks passed. Proceeding with version bump.'"
  },
  "dependencies": {
    "croner": "^11.0.1",
    "jsondiffpatch": "0.7.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "graphql": "^16.15.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "prettier": "^3.9.10",
    "qs-esm": "8.0.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.93.0",
    "payload": "^3.93.0",
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
